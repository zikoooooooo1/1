# Node 24.14+. Load with node --env-file=.env in your process manager.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=https://claso.school.example
DATABASE_PATH=./data/claso.sqlite
STORAGE_PATH=./data/files
# Set to 1 ONLY behind a trusted reverse proxy on loopback.
TRUST_PROXY=0
# School Microsoft Entra ID: single-tenant Web application.
# Configure optional ID-token claim acct. Never commit an actual client secret.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
